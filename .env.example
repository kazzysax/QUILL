# Network: devnet (default) or mainnet
QUILL_NETWORK=devnet

# Public URL of the site (used in links and agent instructions)
QUILL_SITE_URL=http://localhost:3000

# Postgres (Neon, Supabase, Vercel Postgres...). Without it Quill uses an embedded
# database in ./.data (fine for local use; NOT persistent on Vercel).
DATABASE_URL=

# x402 payment service. Defaults: devnet -> https://x402.org/facilitator, mainnet -> https://facilitator.payai.network
FACILITATOR_URL=

# Solana RPC used to check writer token accounts and by the demo agent
SOLANA_RPC_URL=

# Demo agent wallet (DEVNET ONLY): base58 secret key of a wallet holding devnet USDC.
# Powers the /agent page. Leave empty to disable.
DEMO_AGENT_SECRET_KEY=

# Max USDC the demo agent may spend per day across all visitors
DEMO_AGENT_DAILY_CAP_USDC=1

# Set to 1 to skip the writer USDC token-account check (tests only)
QUILL_SKIP_ATA_CHECK=
